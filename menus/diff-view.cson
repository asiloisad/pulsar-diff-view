'context-menu':
  '.tree-view-root:not(.multi-select) .file.selected': [
    {
      label: 'Diff with Active File'
      command: 'diff-view:enable'
    }
  ]

'menu': [
  {
    label: 'Packages'
    submenu: [
      {
        label: 'Diff View'
        submenu: [
          { label: 'Toggle',               command: 'diff-view:toggle' }
          { label: 'Diff with Git HEAD',   command: 'diff-view:git-head' }
          { label: 'Diff with Git Commit', command: 'diff-view:git-commit' }
        ]
      }
    ]
  }
]
